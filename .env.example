# ===============================================
# Realtime Infrastructure
# ===============================================

# --- LiveKit Core
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- LiveKit Telephony Bridge
LIVEKIT_TELEPHONY_MODE=true        # true to enable PSTN bridging, false to keep WebRTC-only

# --- Twilio PSTN Integration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_API_KEY=your-twilio-api-key
TWILIO_API_SECRET=your-twilio-api-secret


# ===============================================
# Conversational AI Providers
# ===============================================

# --- OpenAI Models
OPENAI_MODEL=gpt-4.1               # default model to call in your app
OPENAI_API_KEY=your-openai-api-key

# --- Inworld (NPC / Agent Personalities)
INWORLD_API_KEY=your-inworld-api-key


# ===============================================
# Speech & Audio Services
# ===============================================

# --- Speech Synthesis (Text-to-Speech)
ELEVEN_API_KEY=your-elevenlabs-key
CARTESIA_API_KEY=your-cartesia-key
SARVAM_API_KEY=your-sarvam-key
MURFAI_API_KEY=your-murfai-key

# --- Speech Recognition (Automatic Speech Recognition)
DEEPGRAM_API_KEY=your-deepgram-key
SONIOX_API_KEY=your-soniox-key
ASSEMBLYAI_API_KEY=your-assemblyai-key

# --- Azure Speech (Configure per SDK requirements)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=centralindia   # e.g., centralindia, eastus, westeurope
AZURE_SPEECH_HOST=centralin        # host override if the SDK needs it


# ===============================================
# Messaging & Notifications
# ===============================================

# --- AWS SES Credentials
AWS_SES_ACCESS_KEY_ID=your-aws-ses-access-key-id
AWS_SES_SECRET_ACCESS_KEY=your-aws-ses-secret-access-key
AWS_SES_REGION=ap-south-1          # adjust to the SES region you configured

# --- Email Addresses
EMAIL_FROM_ADDRESS=noreply@databrewery.ai
ONBOARDING_TEAM_EMAIL=onboarding-team@example.com


# ===============================================
# Google Cloud Access
# ===============================================

# --- API Key Based Access
GOOGLE_API_KEY=your-google-api-key

# --- Service Account Credentials
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-credentials.json  # absolute path to service account JSON